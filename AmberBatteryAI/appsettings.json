
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "HomeAssistant": {
    "BaseUrl": "https://ha.bromley.au/",
    "Token": "your-actual-token",
    "BatterySocEntity": "sensor.la_electrical_battery_soc",
    "BatteryPowerEntity": "sensor.la_electrical_battery_power",
    "HomePowerEntity": "sensor.la_sigenstor1_home_power",
    "GridStatusEntity": "sensor.la_sigenstor_1_grid_status",
    "BatteryCapacityKwh": 40.0,
    "GeneralPriceEntity": "sensor.amber_express_home_general_price",
    "FeedInPriceEntity": "sensor.amber_express_home_feed_in_price",
    "WeatherEntity": "weather.welby_hourly",
    "SolarForecastEntity": "sensor.solcast_pv_forecast_forecast_today",
    "SolarForecastRemainingEntity": "sensor.solcast_pv_forecast_forecast_remaining_today",
    "SolarForecastTomorrowEntity": "sensor.solcast_pv_forecast_forecast_tomorrow",
    "GridPowerEntity": "sensor.la_sigenstor1_grid_power",
    "SolarPowerEntity": "sensor.la_sigenstor1_solar_power",
    "GridPowerPositiveIsImport": true
  },
  "AiProvider": {
    "Endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
    "ApiKey": "your-actual-api-key",
    "Model": "gemini-3.5-flash-lite"
  },
  "Optimizer": {
    "IntervalMinutes": 30,
    "ForecastHours": 12,
    "MinExportPrice": 0.08,
    "MaxExportPrice": 5.00,
    "MinExportStopSoc": 20,
    "MaxExportStopSoc": 95,
    "MinImportPrice": -1.00,
    "MaxImportPrice": 0.25,
    "MinImportStopSoc": 30,
    "MaxImportStopSoc": 100,
    "MaxPowerWatts": 10000,
    "DecisionLogRetentionDays": 30,
    "HotWaterKwhPerDegC": 0.12,
    "ExportPowerLimitKw": 5.0,
    "SolarConfidence": 0.6,
    "MorningSolarStartHour": 7.5,
    "AverageLoadKw": 0.9,
    "MorningLoadKw": 1.5,
    "AiAuthority": "shadow",
    "CheapImportPrice": 0,
    "StretchImportPrice": 0,
    "LookAheadBuyEnabled": false,
    "LookAheadBuyTolerance": 0.01,
    "ForceChargeTargetSoc": 90,
    "GridBuyPowerWatts": 5000,
    "PriceWatchEnabled": true,
    "PriceWatchShiftPercent": 10,
    "PriceWatchMinShift": 0.02,
    "PriceWatchCooldownMinutes": 10
  },
  "Telemetry": {
    "SampleIntervalMinutes": 5,
    "ReportDays": 14
  }
}
