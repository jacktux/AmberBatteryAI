@page
@{
    ViewData["Title"] = "Performance";
}

        <div class="card" style="margin-bottom: 16px;">
            <div class="label">Today's Projection (estimate)</div>
            <div class="sub">An estimate of today's cash: what has been realised so far plus a simulation of the rest of the day from Amber price forecasts, the Solcast forecast and your average house load by half-hour. It is updated on every optimizer run, is not a guarantee, and is not used in any decision. Net cash is export revenue minus import cost; "incl. avoided" adds the import cost avoided by solar and battery.</div>
            <div style="overflow-x: auto;">
                <table class="history">
                    <thead>
                        <tr><th></th><th>Exported</th><th>Imported</th><th>Avoided import</th><th>Net cash</th><th>Net incl. avoided</th></tr>
                    </thead>
                    <tbody id="projRows">
                        <tr><td colspan="6">Loading...</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="label" style="margin-top: 12px;">Projected grid flow per hour (estimate)</div>
            <div class="sub">Solid bars are the expected kWh for each hour (red = imported, green = exported); the lighter extension shows the likely high end across the low/base/high Solcast (P10/P90) and feed-in bias scenarios. It does not include day-to-day variation in house load.</div>
            <div id="projChart" style="overflow-x: auto; margin-top: 6px;"></div>
            <div class="sub" id="projSummary" style="margin-top: 8px;"></div>
            <div class="sub" id="projAssumptions" style="margin-top: 4px;"></div>
        </div>

        <div class="card" style="margin-bottom: 16px;">
            <div class="label">Daily Profit &amp; Loss</div>
            <div class="sub">Built from power and price samples taken every few minutes. "Avoided import" is house load served by solar or the battery, valued at the import price. "Best" is the highest feed-in price seen that day; "30 min" is the best 30-minute average.</div>
            <div style="margin-top: 12px; display: flex; gap: 8px; flex-wrap: wrap;">
                <a class="button" href="api/pnl?days=14&amp;format=csv">Download CSV (14 days)</a>
            </div>
            <div style="overflow-x: auto;">
                <table class="history">
                    <thead>
                        <tr><th>Day</th><th>Exported</th><th>Imported</th><th>Avoided import</th><th>Net cash</th><th>Sold at (avg)</th><th>Best price / 30 min</th></tr>
                    </thead>
                    <tbody id="pnlRows">
                        <tr><td colspan="7">Loading...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>


        <div class="card" style="margin-bottom: 16px;">
            <div class="label">Feed-in Forecast Error (14 days)</div>
            <div class="sub">Actual minus forecast feed-in price, by how far ahead the forecast was. Positive means the forecast was too low. Shown only; it is not used in decisions.</div>
            <div style="overflow-x: auto;">
                <table class="history">
                    <thead>
                        <tr><th>Lead time</th><th>Average error</th><th>Average absolute error</th><th>Forecasts compared</th></tr>
                    </thead>
                    <tbody id="biasRows">
                        <tr><td colspan="4">Loading...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>


@section Scripts {
    <script>
        function drawHourly(hours) {
            const box = document.getElementById('projChart');
            if (!hours.length) { box.textContent = 'No grid import or export is projected for the rest of today.'; return; }
            const ns = 'http://www.w3.org/2000/svg';
            const max = Math.max(0.5, ...hours.flatMap(h => [h.import_high_kwh, h.export_high_kwh]));
            const slot = 44, left = 34, top = 8, plot = 140, width = left + hours.length * slot + 6, height = top + plot + 22;
            const svg = document.createElementNS(ns, 'svg');
            svg.setAttribute('width', width); svg.setAttribute('height', height);
            const add = (name, attrs, text) => {
                const el = document.createElementNS(ns, name);
                for (const k in attrs) el.setAttribute(k, attrs[k]);
                if (text !== undefined) el.textContent = text;
                svg.appendChild(el); return el;
            };
            const y = v => top + plot - v / max * plot;
            add('line', { x1: left, x2: width, y1: top + plot, y2: top + plot, stroke: '#666' });
            add('text', { x: left - 4, y: top + 8, 'text-anchor': 'end', 'font-size': 10, fill: '#999' }, max.toFixed(1));
            add('text', { x: left - 4, y: top + plot, 'text-anchor': 'end', 'font-size': 10, fill: '#999' }, '0');
            hours.forEach((h, i) => {
                const x = left + i * slot + 4;
                const bar = (dx, value, high, color, light) => {
                    add('rect', { x: x + dx, y: y(high), width: 16, height: Math.max(0, y(value) - y(high)), fill: light });
                    const r = add('rect', { x: x + dx, y: y(value), width: 16, height: Math.max(0, top + plot - y(value)), fill: color });
                    return r;
                };
                const tip = (el, text) => el.appendChild(Object.assign(document.createElementNS(ns, 'title'), { textContent: text }));
                tip(bar(0, h.import_kwh, h.import_high_kwh, '#e05555', '#e0555566'),
                    'Import ' + h.import_kwh + ' kWh (range ' + h.import_low_kwh + ' to ' + h.import_high_kwh + ')');
                tip(bar(18, h.export_kwh, h.export_high_kwh, '#3fb950', '#3fb95066'),
                    'Export ' + h.export_kwh + ' kWh (range ' + h.export_low_kwh + ' to ' + h.export_high_kwh + ')');
                add('text', { x: x + 17, y: height - 6, 'text-anchor': 'middle', 'font-size': 10, fill: '#999' }, String(h.hour).padStart(2, '0') + ':00');
            });
            box.replaceChildren(svg);
        }

        async function loadProjection() {
            const body = document.getElementById('projRows');
            try {
                const response = await fetch('api/projection');
                body.replaceChildren();
                if (response.status === 204) {
                    body.insertRow().insertCell().textContent = 'No projection yet: it is built after the next optimizer run.';
                    return;
                }

                const p = await response.json();
                const money = v => (v < 0 ? '-$' : '$') + Math.abs(v).toFixed(2);
                const energy = (kwh, dollars) => kwh.toFixed(1) + ' kWh / ' + money(dollars);
                const rows = [
                    ['Realised so far', p.realised.totals],
                    ['Projected rest of day', p.remainder],
                    ['Projected day total', p.day_total]
                ];
                for (const [label, t] of rows) {
                    const row = body.insertRow();
                    for (const text of [label, energy(t.export_kwh, t.export_revenue), energy(t.import_kwh, t.import_cost),
                                        energy(t.avoided_import_kwh, t.avoided_import_value), money(t.net_cash), money(t.net_incl_avoided)])
                        row.insertCell().textContent = text;
                    if (label === 'Projected day total') row.style.fontWeight = '600';
                }

                drawHourly(p.hourly || []);
                const r = p.range, a = p.assumptions;
                document.getElementById('projSummary').textContent =
                    'Likely range for the day: ' + money(r.low_net_cash) + ' to ' + money(r.high_net_cash) +
                    ' net cash (' + money(r.low_net_incl_avoided) + ' to ' + money(r.high_net_incl_avoided) + ' incl. avoided). ' +
                    'Battery ' + p.start_soc_percent + '% now, about ' + p.end_soc_percent + '% at midnight. Updated ' +
                    new Date(p.generated_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + '.';
                document.getElementById('projAssumptions').textContent =
                    'Assumptions: house load ' + a.load_source + ' (' + a.load_kwh_remaining.toFixed(1) + ' kWh to come); solar ' +
                    a.solar_kwh_remaining.toFixed(1) + ' kWh to come; export from ' + (a.export_threshold == null ? 'never' : '$' + a.export_threshold.toFixed(3)) +
                    ' at up to ' + a.export_power_kw.toFixed(1) + ' kW; ' + (a.grid_charging ? 'grid charging on' : 'no grid charging') + '. ' + a.notes.join(' ');
            } catch (err) {
                console.error(err);
            }
        }

        async function loadPnl() {
            const body = document.getElementById('pnlRows');
            try {
                const days = (await (await fetch('api/pnl?days=14')).json()).reverse();
                body.replaceChildren();

                if (days.length === 0) {
                    const cell = body.insertRow().insertCell();
                    cell.colSpan = 7;
                    cell.textContent = 'No samples recorded yet.';
                    return;
                }

                const money = v => (v < 0 ? '-$' : '$') + Math.abs(v).toFixed(2);
                const price = v => v == null ? '--' : '$' + v.toFixed(3);
                for (const d of days) {
                    const cells = [
                        d.date,
                        d.export_kwh.toFixed(1) + ' kWh / ' + money(d.export_revenue),
                        d.import_kwh.toFixed(1) + ' kWh / ' + money(d.import_cost),
                        d.avoided_import_kwh.toFixed(1) + ' kWh / ' + money(d.avoided_import_value),
                        money(d.net_cash),
                        price(d.achieved_sell_price),
                        price(d.best_sell_price) + ' / ' + price(d.best_sell_price_30min)
                    ];
                    const row = body.insertRow();
                    row.title = d.samples + ' samples covering ' + d.covered_hours + ' h';
                    for (const text of cells) row.insertCell().textContent = text;
                }
            } catch (err) {
                console.error(err);
            }
        }

        async function loadBias() {
            const body = document.getElementById('biasRows');
            try {
                const report = await (await fetch('api/forecast-bias')).json();
                body.replaceChildren();
                const signed = v => v == null ? '--' : (v >= 0 ? '+$' : '-$') + Math.abs(v).toFixed(3);
                for (const b of report.buckets) {
                    const row = body.insertRow();
                    for (const text of [b.bucket, signed(b.mean_error), b.mean_abs_error == null ? '--' : '$' + b.mean_abs_error.toFixed(3), b.count])
                        row.insertCell().textContent = text;
                }
            } catch (err) {
                console.error(err);
            }
        }

        function onNewRun() { loadProjection(); loadPnl(); loadBias(); }
    </script>
}
