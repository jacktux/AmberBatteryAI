@page
@{
    ViewData["Title"] = "Decisions";
}

        <div class="card" style="margin-bottom: 16px;">
            <div class="label">AI Decision History</div>
            <div class="sub">Every run is saved and published to Home Assistant as <code>sensor.battery_ai_decision</code> (History) and in the Activity panel. Hover a row to see the AI's reasoning.
            Time colour: <span style="color:#4ade80">green</span> = scheduled run, <span style="color:#f87171">red</span> = triggered by a price move (reason in the notes), <span style="color:#fbbf24">amber</span> = manual run.</div>
            <div style="margin-top: 12px; display: flex; gap: 8px; flex-wrap: wrap;">
                <a class="button" href="api/decisions?days=7&amp;format=csv">Download CSV summary (7 days)</a>
                <a class="button" href="api/decisions?days=7&amp;format=jsonl" style="background: var(--muted);">Download full log (7 days)</a>
            </div>
            <div style="overflow-x: auto;">
                <table class="history">
                    <thead>
                        <tr><th>Time</th><th>Result</th><th>Export</th><th>Import</th><th>Hot water</th><th>Overrides / notes</th></tr>
                    </thead>
                    <tbody id="historyRows">
                        <tr><td colspan="6">Loading...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>


        <div class="card" style="margin-bottom: 16px;">
            <div class="label">Latest AI Prompt Sent</div>
            <button type="button" onclick="copyLatestPrompt()" style="margin-top: 8px;">Copy Prompt</button>
            <span id="copyStatus" style="margin-left: 8px; color: var(--muted); font-size: 0.9rem;"></span>
            <pre class="prompt" id="prompt">Waiting for first optimization cycle...</pre>
        </div>


@section Scripts {
    <script>
        async function loadHistory() {
            const body = document.getElementById('historyRows');
            try {
                const res = await fetch('api/decisions?days=3&limit=10');
                const entries = (await res.json()).reverse();
                body.replaceChildren();

                if (entries.length === 0) {
                    const cell = body.insertRow().insertCell();
                    cell.colSpan = 6;
                    cell.textContent = 'No decisions recorded yet.';
                    return;
                }

                for (const e of entries) {
                    const a = e.applied;
                    const result = e.outcome === 'applied' && e.ai_response ? e.ai_response.mode : e.outcome;
                    const ev = e.computed && e.computed.ev_grab_applied != null && e.computed.ev_grab_applied !== e.computed.ev_grab_base
                    ? ['Car solar-grab threshold ' + e.computed.ev_grab_base + '% -> ' + e.computed.ev_grab_applied + '% (' + e.computed.ev_grab_reason + ')'] : [];
                    const why = e.trigger === 'price' ? ['Triggered by price move: ' + (e.trigger_reason || 'live price beat its forecast')]
                        : e.trigger === 'manual' ? ['Manual run' + (e.trigger_reason ? ': ' + e.trigger_reason : '')] : [];
                    const lev = e.ai_levers && e.ai_levers.summary ? [e.ai_levers.summary] : [];
                    const notes = why.concat(e.overrides || [], ev, lev, e.note ? [e.note] : []).join('; ');
                    const cells = [
                        new Date(e.timestamp).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }),
                        result,
                        a ? '>= $' + a.export_price.toFixed(3) + ' to ' + a.export_stop_soc + '%' : '--',
                        a ? '<= $' + a.import_price.toFixed(2) + ' to ' + a.import_stop_soc + '%' : '--',
                        a && a.hot_water ? a.hot_water : '--',
                        notes
                    ];

                    const row = body.insertRow();
                    if (e.ai_response && e.ai_response.reasoning) row.title = e.ai_response.reasoning;
                    for (const text of cells) row.insertCell().textContent = text;
                    const timeColour = { scheduled: '#4ade80', price: '#f87171', manual: '#fbbf24' }[e.trigger];
                    if (timeColour) {
                        const t = row.cells[0];
                        t.style.color = timeColour;
                        t.style.fontWeight = '600';
                        t.style.borderLeft = '3px solid ' + timeColour;
                    }
                }
            } catch (err) {
                console.error(err);
            }
        }

        async function copyLatestPrompt() {
            const text = document.getElementById('prompt').textContent;
            const status = document.getElementById('copyStatus');
            try {
                await navigator.clipboard.writeText(text);
                status.textContent = 'Copied';
            } catch (e) {
                status.textContent = 'Copy failed';
            }
            setTimeout(() => status.textContent = '', 2000);
        }

        function onNewRun() { loadHistory(); }

        function onStatus(data) {
            if (data.prompt) document.getElementById('prompt').textContent = data.prompt;
        }
    </script>
}
